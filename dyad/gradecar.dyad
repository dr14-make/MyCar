"Longitudinal car on a flat road: torque command in, speed in km/h out."
component GradeCar
  "Commanded engine torque"
  tau_cmd = Dyad.RealInput() {^tau_cmd}
  "Vehicle speed in km/h"
  v_kmh = Dyad.RealOutput() {^v_kmh}
  engine = MyCar.Engine() {^engine}
  driveline = MyCar.Driveline() {^driveline}
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  to_kmh = BlockComponents.Math.Gain(k = 3.6) {^to_kmh}
  "Engine mounts and gearbox housing"
  rot_ground = RotationalComponents.Components.Fixed() {^rot_ground}
  "Road under the wheel"
  trans_ground = TranslationalComponents.Components.Fixed() {^trans_ground}
  body = MyCar.GradeBody() {^body}
  grade = Dyad.RealInput() {^grade}
relations
  connect(tau_cmd, engine.tau_cmd) {^id11}
  connect(engine.spline, driveline.spline) {^id12}
  connect(engine.support, rot_ground.spline) {^id13}
  connect(driveline.support_r, rot_ground.spline) {^id14}
  connect(driveline.support_t, trans_ground.flange) {^id15}
  connect(vsensor.v, to_kmh.u) {^id16}
  connect(to_kmh.y, v_kmh) {^id17}
  connect(driveline.flange, vsensor.flange, body.flange) {^id18}
  connect(grade, body.grade) {^id19}
metadata {
  "Dyad": {
    "icons": {"default": "dyad://MyCar/Car.svg"},
