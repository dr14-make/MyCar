"short CruiseController component description"
component CruiseController
  error = BlockComponents.Math.Add(k2 = -1.0) {^error}
  u_s = Dyad.RealInput() {^u_s}
  u_m = Dyad.RealInput() {^u_m}
  y = Dyad.RealOutput() {^y}
  gain = BlockComponents.Math.Gain(k = k) {^gain}
  "Proportional gain"
  parameter k::Real() = 56
  add_pid = BlockComponents.Math.Add3() {^add_pid}
  integrator = BlockComponents.Continuous.Integrator(x0 = x0i, k = 1.0 / Ti) {^integrator}
  constant1 = BlockComponents.Sources.Constant(k = 0) {^constant1}
  parameter Ti::Real() = 10
  parameter x0i::Real() = 0
relations
  connect(u_s, error.u1) {^id9}
  connect(u_m, error.u2) {^id10}
  connect(gain.y, y) {^id11}
  connect(add_pid.y, gain.u) {^id12}
  connect(error.y, add_pid.u1) {^id13}
  connect(error.y, integrator.u) {^id14}
  connect(integrator.y, add_pid.u2) {^id15}
  connect(constant1.y, add_pid.u3) {^id16}
