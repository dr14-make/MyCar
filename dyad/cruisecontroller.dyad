"short CruiseController component description"
component CruiseController
  error = BlockComponents.Math.Add(k2 = -1.0) {^error}
  u_s = Dyad.RealInput() {^u_s}
  u_m = Dyad.RealInput() {^u_m}
  y = Dyad.RealOutput() {^y}
  gain = BlockComponents.Math.Gain(k = k) {^gain}
  "Proportional gain"
  parameter k::Real() = 56
relations
  connect(u_s, error.u1) {^id6}
  connect(u_m, error.u2) {^id7}
  connect(gain.y, y) {^id8}
  connect(error.y, gain.u) {^id9}
