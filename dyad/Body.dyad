end

test component TestBody
  "Constant tractive force from rest"
  tractive = TranslationalComponents.Sources.ConstantForce(f_constant = 500) {^tractive}
  body = Body() {^body}
  fixed = TranslationalComponents.Components.Fixed() {^fixed}
relations
  connect(tractive.flange, body.flange) {^id1}
  connect(tractive.support, fixed.flange) {^id2}
  initial body.mass.s = 0
  initial body.mass.v = 0
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 800,
        "atol": {"body.mass.a": 0.001, "body.mass.v": 0.001},
        "expect": {
          "initial": {"body.mass.a": 0.35714285714285715, "body.mass.v": 0},
          "final": {"body.mass.a": 0, "body.mass.v": 29.780869893947216},
          "signals": ["body.mass.v"]
        }
      }
    }
  },
  "_links": {
    "tractive": {
      "Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 450, "y2": 550}}}
    },
    "body": {"Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 450, "y2": 550}}}},
    "fixed": {"Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 700, "y2": 800}}}},
    "id1": {
      "Dyad": {
        "edges": [
          {"S": 1, "M": [{"x": 300, "y": 500}, {"x": 300, "y": 620}, {"x": 600, "y": 620}, {"x": 600, "y": 500}], "E": 2}
        ],
        "path": {}
      }
    },
    "id2": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  }
}
end
