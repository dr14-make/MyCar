test component TestWheeledDriveline
  "Constant engine-side torque"
  torque = RotationalComponents.Sources.ConstantTorque(tau_constant = 100) {^torque}
  driveline = WheeledDriveline() {^driveline}
  housing = RotationalComponents.Components.Fixed() {^housing}
  mass = TranslationalComponents.Components.Mass(m = 1400) {^mass}
  road = TranslationalComponents.Components.Fixed() {^road}
relations
  connect(torque.spline, driveline.spline) {^id1}
  connect(torque.support, housing.spline) {^id2}
  connect(driveline.support_r, housing.spline) {^id3}
  connect(driveline.flange, mass.flange_a) {^id4}
  connect(driveline.support_t, road.flange) {^id5}
  initial driveline.inertia.phi = 0
  initial driveline.inertia.w = 0
  initial mass.s = 0
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 10,
        "atol": {"mass.a": 0.0001, "mass.v": 0.001},
        "expect": {
          "initial": {"mass.a": 0.9148590822, "mass.v": 0},
          "final": {"mass.a": 0.9148590822, "mass.v": 9.148590822},
          "signals": ["mass.v", "driveline.inertia.w"]
        }
      }
    }
  },
  "_links": {
    "torque": {"Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 450, "y2": 550}}}},
    "driveline": {"Dyad": {"placement": {"diagram": {"x1": 350, "x2": 450, "y1": 450, "y2": 550}}}},
    "housing": {"Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 700, "y2": 800}}}},
    "mass": {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 450, "y2": 550}}}},
    "road": {"Dyad": {"placement": {"diagram": {"x1": 361, "x2": 461, "y1": 700, "y2": 800}}}},
    "id1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id2": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id3": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 388, "y": 650}, {"x": 150, "y": 650}], "E": 2}],
        "path": {}
      }
    },
    "id4": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  }
}
end
