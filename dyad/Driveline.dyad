"""Gearbox and rolling wheel: engine shaft in, tractive force on the body out."""
component Driveline
  "From the engine"
  spline = Spline() {^spline}
  "Gearbox housing"
  support_r = Spline() {^support_r}
  "To the body"
  flange = Flange() {^flange}
  "Road"
  support_t = Flange() {^support_t}
  gear = RotationalComponents.Components.IdealGear(ratio = i) {^gear}
  wheel = RotationalComponents.Components.IdealRollingWheel(radius = r) {^wheel}
  "Gear ratio"
  parameter i::Real = 4.0
  "Wheel rolling radius"
  parameter r::Length = 0.31
relations
  connect(spline, gear.spline_a) {^id1}
  connect(gear.spline_b, wheel.spline) {^id2}
  connect(wheel.flange, flange) {^id3}
  connect(gear.support, support_r) {^id4}
  connect(wheel.support_r, support_r) {^id5}
  connect(wheel.support_t, support_t) {^id6}
metadata {
  "Dyad": {
    "icons": {"default": "dyad://MyCar/Driveline.svg"},
    "labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}]
  },
  "_links": {
    "spline": {
      "Dyad": {
        "placement": {
          "icon": {"x1": -40, "x2": 60, "y1": 450, "y2": 550},
          "diagram": {"x1": -40, "x2": 60, "y1": 450, "y2": 550}
        }
      }
    },
    "support_r": {
