"Full WLTC hybrid run on the step 3 starter (derived; VehicleSystemsComponents.Lecture5.P2HybridWLTCTransient)."
analysis Step3HybridWLTCTransient
  extends TransientAnalysis(stop = 1800.0, alg = ODEAlg.Rodas5P(), dtmax = 1.0, optimize = OptimizationLevel.None())
  model = Step3HybridWLTC()
relations
end