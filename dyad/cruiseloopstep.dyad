"short CruiseLoopStep component description"
component CruiseLoopStep
  demand = BlockComponents.Sources.Step(offset = 90, height = 20) {^demand}
  constant1 = BlockComponents.Sources.Constant(k = 0.0) {^constant1}
  controller = MyCar.CruiseController(k = k) {^controller}
  plant = MyCar.GradeCar() {^plant}
  "Proportional gain"
  parameter k::Real() = 56
  parameter Ti::Real() = 10
  parameter xi0::Real() = 0
relations
  connect(constant1.y, plant.grade) {^id5}
  connect(controller.y, plant.tau_cmd) {^id6}
  connect(plant.v_kmh, controller.u_m) {^id7}
  connect(demand.y, controller.u_s) {^id8}
  initial plant.body.mass.s = 0
  initial plant.body.mass.v = 90 / 3.6
  initial plant.engine.lag.x = 31.078
metadata {
