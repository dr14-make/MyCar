"""Full throttle from rest on a slippery flat road: the wheel spins up, the car barely moves."""
component SlipCarStandingStart
  "Full throttle"
  cmd = BlockComponents.Sources.Constant(k = 150) {^cmd}
  "Flat road"
  road = BlockComponents.Sources.Constant(k = 0) {^road}
  "Slippery road; 1.0 is dry"
  friction = BlockComponents.Sources.Constant(k = 0.2) {^friction}
  car = SlipCar() {^car}
relations
  connect(cmd.y, car.tau_cmd) {^id1}
  connect(road.y, car.grade) {^id2}
  connect(friction.y, car.mu_scale) {^id3}
  initial car.body.mass.s = 0
  initial car.body.mass.v = 0
  initial car.engine.lag.x = 0
  initial car.wheel_inertia.phi = 0
  initial car.wheel_inertia.w = 0
metadata {
  "Dyad": {
    "tests": {
      "low_friction": {
        "stop": 5,
        "params": {"friction.k": 0.2},
        "atol": {"car.v_kmh": 0.1, "car.wheel_kmh": 0.5},
        "expect": {
          "initial": {"car.v_kmh": 0, "car.wheel_kmh": 0},
          "final": {"car.v_kmh": 10.1163, "car.wheel_kmh": 1501.063},
          "signals": ["car.v_kmh", "car.wheel_kmh"]
        }
      },
      "dry_road": {
        "stop": 5,
        "params": {"friction.k": 1.0},
        "atol": {"car.v_kmh": 0.1, "car.wheel_kmh": 0.5},
        "expect": {
          "initial": {"car.v_kmh": 0, "car.wheel_kmh": 0},
          "final": {"car.v_kmh": 21.0761, "car.wheel_kmh": 21.2353},
          "signals": ["car.v_kmh", "car.wheel_kmh"]
        }
      }
    }
  },
  "_links": {
    "road": {"Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 250, "y2": 350}}}},
    "friction": {
      "Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 450, "y2": 550}}}
    },
    "cmd": {"Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 650, "y2": 750}}}},
    "car": {"Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 450, "y2": 550}}}},
    "id1": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 400, "y": 700}, {"x": 400, "y": 535}], "E": 2}],
        "path": {}
      }
    },
    "id2": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 300, "y": 300}, {"x": 300, "y": 457}], "E": 2}],
        "path": {}
      }
    },
    "id3": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 350, "y": 500}, {"x": 350, "y": 472}], "E": 2}],
        "path": {}
      }
    }
  }
}
end

analysis SlipCarStandingStartTransient
  extends TransientAnalysis(stop = 5)
  model = SlipCarStandingStart()
end
